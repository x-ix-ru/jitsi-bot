JITSI_WEBSOCKET_URL=wss://jitsi.example.org/xmpp-websocket
JITSI_ROOM=transport-probe
JITSI_NICK=hermes-transport-probe
AUDIO_OUTPUT_DIR=/data/audio
TEST_TONE_HZ=440
TEST_TONE_VOLUME=0.05
# Optional, depending on your deployment:
# JITSI_XMPP_DOMAIN=jitsi.example.org
# JITSI_MUC_DOMAIN=conference.jitsi.example.org
# JITSI_FOCUS_JID=focus@auth.jitsi.example.org/focus
# JITSI_XMPP_USERNAME=bot
# JITSI_XMPP_PASSWORD=secret
# JITSI_XMPP_JWT=token
